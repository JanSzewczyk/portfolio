{
  "name": "portfolio",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "next experimental-analyze",
    "biome:check": "biome check .",
    "biome:ci": "biome ci --reporter=github",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format .",
    "biome:format:fix": "biome format --write .",
    "biome:lint": "biome lint .",
    "biome:lint:fix": "biome lint --write .",
    "build": "next build",
    "dev": "next dev",
    "knip": "knip",
    "knip:ci": "knip --reporter github-actions",
    "sanity:deploy": "sanity deploy",
    "sanity:dev": "sanity dev",
    "sanity:typegen": "sanity schema extract && sanity typegen generate",
    "start": "next start",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:serve": "serve storybook-static",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest --coverage",
    "test:coverage": "vitest --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ci": " playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui --pass-with-no-tests",
    "test:storybook": "vitest --project=storybook --coverage --passWithNoTests",
    "test:storybook:coverage": "vitest run --project=storybook --coverage.enabled --coverage.reportsDirectory=coverage-storybook",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project=unit --passWithNoTests",
    "test:unit:coverage": "vitest run --project=unit --coverage.enabled --coverage.reportsDirectory=coverage-unit",
    "test:watch": "vitest watch --passWithNoTests",
    "type-check": "next typegen && tsc --noEmit"
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "edge >= 111",
    "not dead"
  ],
  "overrides": {
    "@sanity/client": "$@sanity/client",
    "smol-toml": "^1.9.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@loglayer/transport-log-file-rotation": "^3.3.0",
    "@loglayer/transport-pino": "^3.3.0",
    "@react-email/components": "^1.0.12",
    "@sanity/client": "^8.9.0",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.0.3",
    "@sanity/ui": "^4.4.0",
    "@sanity/vision": "^6.18.0",
    "@szum-tech/design-system": "^3.21.9",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "loglayer": "^9.4.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-sanity": "^13.3.4",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "sanity": "^6.18.0",
    "serialize-error": "^13.0.2",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@chromatic-com/storybook": "^5.4.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@storybook-community/storybook-dark-mode": "^7.1.4",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@szum-tech/semantic-release-config": "^2.3.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "knip": "^6.41.0",
    "mimicry-js": "^1.3.0",
    "playwright": "^1.64.0",
    "sanity-plugin-markdown": "^9.0.15",
    "schema-dts": "^2.1.0",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.6",
    "storybook": "^10.6.2",
    "storybook-addon-tag-badges": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
