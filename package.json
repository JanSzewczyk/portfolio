{
  "name": "portfolio",
  "version": "1.8.4",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "biome:check": "biome check .",
    "biome:ci": "biome ci --reporter=github",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format .",
    "biome:format:fix": "biome format --write .",
    "biome:lint": "biome lint .",
    "biome:lint:fix": "biome lint --write .",
    "build": "next build",
    "dev": "next dev",
    "sanity:deploy": "sanity deploy",
    "sanity:dev": "sanity dev",
    "sanity:typegen": "sanity schema extract && sanity typegen generate",
    "start": "next start",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:serve": "serve storybook-static",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest --coverage",
    "test:coverage": "vitest --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ci": " playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui --pass-with-no-tests",
    "test:storybook": "vitest --project=storybook --coverage --passWithNoTests",
    "test:storybook:coverage": "vitest run --project=storybook --coverage.enabled --coverage.reportsDirectory=coverage-storybook",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project=unit --passWithNoTests",
    "test:unit:coverage": "vitest run --project=unit --coverage.enabled --coverage.reportsDirectory=coverage-unit",
    "test:watch": "vitest watch --passWithNoTests",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/bundle-analyzer": "^16.1.5",
    "@react-email/components": "^1.0.6",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "^5.13.0",
    "@szum-tech/design-system": "^3.12.2",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tailwindcss/postcss": "^4.2.1",
    "@vercel/analytics": "^1.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "next": "^16.1.5",
    "next-compose-plugins": "^2.2.1",
    "next-sanity": "12.1.1",
    "next-themes": "^0.4.6",
    "pigeon-maps": "^0.22.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
    "resend": "^6.9.3",
    "sanity": "^5.13.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.3.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@chromatic-com/storybook": "^5.0.0",
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "^1.58.0",
    "@storybook-community/storybook-dark-mode": "^7.1.1",
    "@storybook/addon-a11y": "10.2.16",
    "@storybook/addon-docs": "10.2.16",
    "@storybook/addon-vitest": "10.2.16",
    "@storybook/nextjs-vite": "10.2.16",
    "@szum-tech/semantic-release-config": "^2.3.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "25.3.5",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "mimicry-js": "^1.3.0",
    "playwright": "^1.58.0",
    "schema-dts": "^1.1.5",
    "semantic-release": "^25.0.0",
    "serve": "^14.2.6",
    "storybook": "10.2.16",
    "storybook-addon-tag-badges": "^3.0.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
