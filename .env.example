# File for app envs template

# Site Configuration
NEXT_PUBLIC_VERCEL_URL=

# Logging configuration
# LOG_LEVEL can be: fatal, error, warn, info, debug, trace
LOG_LEVEL=debug

# Sanity.io Configuration

# Next.js Client Environment Variables
# Get these values from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-27
# Sanity API Read Token (required for Visual Editing & Live Content API)
# Create at: https://www.sanity.io/manage/project/YOUR_PROJECT_ID/api#tokens
# Permissions: Viewer (read-only access)
SANITY_API_READ_TOKEN=sanity_api_read_token_here
# Secret for Sanity revalidation endpoint
SANITY_REVALIDATE_SECRET=sanity_revalidate_secret_here

# Sanity Studio Deployment Environment Variables
# Set these in Sanity Dashboard: https://www.sanity.io/manage/project/YOUR_PROJECT_ID/api
# These are used by the deployed Sanity Studio at https://jrs-portfolio.sanity.studio
SANITY_STUDIO_API_PROJECT_ID=your-project-id
SANITY_STUDIO_API_DATASET=production
SANITY_STUDIO_API_VERSION=2026-01-27
# Sanity App ID (used for Visual Editing & Live Content API)
SANITY_DEPLOYMENT_APP_ID=your-app-id

# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Email address to send from (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Email address to receive contact form submissions
RESEND_TO_EMAIL=your-email@example.com
